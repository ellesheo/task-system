{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/users/{**catch-all}" }
      },
      "tasks-route": {
        "ClusterId": "tasks-cluster",
        "Match": { "Path": "/tasks/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "d1": { "Address": "http://users-service:8080/" }
        }
      },
      "tasks-cluster": {
        "Destinations": {
          "d1": { "Address": "http://tasks-service:8080/" }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "d1": { "Address": "http://notifications-service:8080/" }
        }
      }
    }
  }
}
